# Dolt database and optional proxy state (managed by Beads, never versioned)
dolt/
embeddeddolt/
proxieddb/
dolt-access.lock

# Runtime files
bd.sock
bd.sock.startlock
sync-state.json
last-touched
last_pull
.exclusive-lock

# Daemon, server, and workspace-operation runtime
# Includes process locks, ports, activity markers, monitor state, and pprof output.
daemon.*
*.lock
*.gate.lock*
dolt-server.pid
dolt-server.log
dolt-server.lock
dolt-server.port
dolt-server.activity
dolt-monitor.pid
dolt-pprof/
proxied_server_client_info.json

# Local interaction, synchronization, and export state
interactions.jsonl
push-state.json
.sync.lock
export-state/
export-state.json

# Local version and worktree discovery
.local_version
redirect

# Ephemeral local stores
ephemeral.sqlite3
ephemeral.sqlite3-journal
ephemeral.sqlite3-wal
ephemeral.sqlite3-shm

# Backup data and recovery artifacts
backup/
*.corrupt.backup/

# Local credentials and connection configuration
.beads-credential-key
.env

# Legacy local database files
*.db
*.db?*
*.db-journal
*.db-wal
*.db-shm
db.sqlite
bd.db

# Config files (metadata.json, config.yaml) and issue exports are tracked.
# Do NOT add negation patterns here, as they can override fork protection.
